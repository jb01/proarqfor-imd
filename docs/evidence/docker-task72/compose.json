{
  "services": {
    "web": {
      "build": {
        "context": "/home/josemberg/Documentos/MESTRADO/DEV-ia/proarqfor-imd",
        "dockerfile": "Dockerfile"
      },
      "image": "arqfor-task72-demo:local",
      "ports": [
