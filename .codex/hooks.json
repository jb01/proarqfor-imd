{
  "description": "arqfor_v1.0: hooks de fast e Docker preparados; ativação depende de confiança e validação em ambiente descartável. Nenhuma regra substitui a outra.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^ARQFOR_HOOK_DESABILITADO$",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"/home/josemberg/Documentos/MESTRADO/DEV-ia/proarqfor-imd/.codex/hooks/bloquear-exclusao-fast.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^ARQFOR_DOCKER_HOOK_DESABILITADO$",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"/home/josemberg/Documentos/MESTRADO/DEV-ia/proarqfor-imd/.codex/hooks/bloquear-docker.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
